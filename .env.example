# Copy to .env. Never commit the real .env file.
CIPHERX_SESSION_SECRET=replace-with-a-long-random-value

# Google Cloud OAuth web client
CIPHERX_GOOGLE_CLIENT_ID=
CIPHERX_GOOGLE_CLIENT_SECRET=
CIPHERX_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/gmail/oauth/callback

# Microsoft Entra OAuth web application
CIPHERX_MICROSOFT_CLIENT_ID=
CIPHERX_MICROSOFT_CLIENT_SECRET=
CIPHERX_MICROSOFT_REDIRECT_URI=http://127.0.0.1:8000/api/mail/oauth/outlook/callback
